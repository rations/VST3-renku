name			vst3_renku
version			0.4.0-3
architecture	x86_64
summary			"VST3 host on the native Media Kit, and example VST3 plug-ins (RenkuOS)"
description		"A headless VST3 host (vst3host) on the RenkuOS Media Kit, built on the
RenkuOS port of the Steinberg VST3 SDK, plus the SDK's example plug-ins (adelay,
the mda suite, ...). It runs one plug-in as a media node: its outputs go to the
system mixer and its inputs are connected from its command line; no JACK is
needed. With the jack package installed it also runs on JACK (--backend jack).
The SDK's own JACK host, vst3jackhost, is the separate vst3_renku_jack package. The VST3 SDK itself is a
build-time dependency of Kasen and the plug-ins and is linked statically."
packager		"rations <ehqcar@proton.me>"
vendor			"rations"
copyrights {
	"2025 Steinberg Media Technologies GmbH"
	"2026 rations"
}
licenses {
	"MIT"
}
provides {
	vst3_renku = 0.4.0
	cmd:vst3host = 0.4.0
}
requires {
	haiku
	libsamplerate
}
replaces {
	vst3_haiku
}
urls {
	"https://github.com/rations/VST3-renku"
}
